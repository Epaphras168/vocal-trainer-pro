# Belto runs fully offline without these. Set them to switch on accounts,
# cloud backup and friends (see README: "Accounts & friends").
VITE_SUPABASE_URL=https://your-project.supabase.co
# The project's anon / publishable key (safe to ship in the browser; row level
# security in supabase/migrations protects the data).
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shown on the Privacy Policy and Terms pages (people email this to ask for
# their account to be deleted). Set it; it is published on the site.
VITE_CONTACT_EMAIL=you@example.com

# Optional: show "Continue with Google". Only turn this on once Google sign-in
# is set up AND your Google app is published to production (see README).
# VITE_GOOGLE_SIGNIN=true

# Optional: report crashes (error text, page path, app version and browser only;
# never a name, email, progress or audio). From a Sentry project: Settings >
# Client Keys (DSN). The Privacy page changes its wording when this is set.
# VITE_SENTRY_DSN=https://publickey@o0.ingest.sentry.io/0

# Optional: Cloudflare Turnstile "are you a person?" check on sign-up, sign-in and
# password reset. Site key here; the secret key goes in Supabase (Authentication >
# Attack Protection > CAPTCHA), and you must turn that on there too.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Development only: a pretend friends server in localStorage. "Continue with
# Google" signs in instantly, as does any email with a 6+ character password;
# friend code ZURI77 can be added.
# VITE_CLOUD_MOCK=true
