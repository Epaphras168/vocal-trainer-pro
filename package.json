{
  "name": "belto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Belto \u2014 bite-sized, game-like singing lessons that listen back.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "scripts/test-db.sh",
    "build:mock": "VITE_CLOUD_MOCK=true VITE_GOOGLE_SIGNIN=true VITE_CONTACT_EMAIL=beta@example.com vite build --mode e2e --outDir dist-mock",
    "test:e2e": "node e2e/smoke.mjs",
    "test:contrast": "node e2e/contrast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.0",
    "pitchy": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.1",
    "typescript": "~5.9.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
